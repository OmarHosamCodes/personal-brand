---
/** Hero name lockup: logo terminal for O, twin slashes for H. Spelling stays Omar Hosam. */
---

<h1
  id="hero-name"
  class="font-display m-0 text-[clamp(3rem,10vw,6.5rem)] leading-[0.9] font-semibold tracking-[-0.04em]"
  aria-label="Omar Hosam"
>
  <span
    class="inline-flex flex-wrap items-center justify-center gap-[0.12em]"
    aria-hidden="true"
  >
    <span class="inline-flex items-center">
      <svg
        class="mx-[0.02em] h-[0.72em] w-[0.72em] shrink-0 translate-y-[0.04em] text-foreground"
        viewBox="2 26 12 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        focusable="false"
      >
        <circle cx="8" cy="32" r="6" fill="currentColor"></circle>
      </svg>
      <span>mar</span>
    </span>
    <span class="inline-flex items-center">
      <svg
        class="mx-[0.04em] h-[0.88em] w-[0.72em] shrink-0 translate-y-[0.02em]"
        viewBox="14 16 28 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        focusable="false"
      >
        <line
          x1="16"
          y1="46"
          x2="28"
          y2="18"
          stroke="var(--primary)"
          stroke-width="4"
          stroke-linecap="round"
        ></line>
        <line
          x1="28"
          y1="46"
          x2="40"
          y2="18"
          stroke="var(--primary)"
          stroke-width="4"
          stroke-linecap="round"
        ></line>
      </svg>
      <span>osam</span>
    </span>
  </span>
</h1>
