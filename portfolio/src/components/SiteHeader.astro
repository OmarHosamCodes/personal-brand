---
import { BrandMark } from './BrandMark';
import { site } from '../content/site';

const nav = [
  { href: '#work', id: 'work', label: 'Work' },
  { href: '#experience', id: 'experience', label: 'Experience' },
  { href: '#contact', id: 'contact', label: 'Contact' },
] as const;
---

<header class="border-border sticky top-0 z-40 border-b bg-background pt-[env(safe-area-inset-top)]">
  <div
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-5 md:gap-4 md:px-8"
  >
    <a
      href="/"
      aria-label={site.name}
      class="text-foreground focus-visible:ring-ring inline-flex min-h-11 w-fit shrink-0 items-center rounded-[10px] no-underline outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <BrandMark className="size-8" decorative />
    </a>

    <nav
      class="site-header__nav hidden items-center md:flex"
      aria-label="Primary"
      data-site-nav
    >
      {
        nav.map((item) => (
          <a
            class="site-header__link font-label text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex h-11 items-center px-2.5 no-underline outline-none transition-colors duration-[var(--duration-control)] ease-[var(--ease-broadcast)] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            href={item.href}
            data-nav-id={item.id}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  {/* DESIGN: mobile sticky horizontal strip when vertical rail is impractical */}
  <nav
    class="site-header__nav border-border md:hidden flex gap-0.5 overflow-x-auto border-t px-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    aria-label="Sections"
    data-site-nav
  >
    {
      nav.map((item) => (
        <a
          class="site-header__link font-label text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex h-11 shrink-0 items-center px-3 no-underline outline-none transition-colors duration-[var(--duration-control)] ease-[var(--ease-broadcast)] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          href={item.href}
          data-nav-id={item.id}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header__link {
    position: relative;
  }

  .site-header__link[aria-current='true'] {
    color: var(--foreground);
  }

  .site-header__link[aria-current='true']::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--primary);
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__link {
      transition: none;
    }
  }
</style>

<script>
  const ids = ['work', 'experience', 'contact'] as const;

  function setCurrent(id: string | null) {
    document.querySelectorAll('[data-nav-id]').forEach((link) => {
      const el = link as HTMLAnchorElement;
      const match = id !== null && el.dataset.navId === id;
      if (match) el.setAttribute('aria-current', 'true');
      else el.removeAttribute('aria-current');
    });
  }

  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        const id = visible[0]?.target?.id;
        if (id) setCurrent(id);
      },
      {
        rootMargin: '-20% 0px -55% 0px',
        threshold: [0, 0.25, 0.5, 1],
      },
    );

    sections.forEach((section) => observer.observe(section));

    const hash = window.location.hash.slice(1);
    if ((ids as readonly string[]).includes(hash)) setCurrent(hash);
  }
</script>
