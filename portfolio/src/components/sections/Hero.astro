---
import CurvedLoop from '../react-bits/CurvedLoop';
import NameLockup from '../NameLockup.astro';
import HeroCta from '../HeroCta.astro';
import OfferRail from '../OfferRail.astro';
import { site } from '../../content/site';
---

<section
  class="relative isolate overflow-hidden border-b border-border select-none"
  aria-labelledby="hero-name"
>
  <div
    class="relative z-10 mx-auto flex min-h-[min(100svh,56rem)] max-w-6xl flex-col px-5 pt-10 pb-0 md:px-8 md:pt-14"
  >
    <div class="flex flex-col items-center text-center">
      <NameLockup />

      <OfferRail />

      <HeroCta />
    </div>

    {/* Portrait stage: full-bleed curved text behind the image */}
    <div class="relative mt-10 w-full md:mt-12">
      <div
        class="pointer-events-none absolute top-1/2 left-1/2 z-0 w-screen -translate-x-1/2 -translate-y-1/2"
        aria-hidden="true"
      >
        <div class="pointer-events-auto w-full">
          <CurvedLoop
            client:load
            marqueeText={`${site.title} ● `}
            speed={0.55}
            curveAmount={380}
            direction="left"
            interactive={true}
            className="curved-loop-brand"
          />
        </div>
      </div>

      <figure class="hero-portrait relative z-10 m-0 mx-auto w-full max-w-3xl">
        <img
          src={site.portrait.src}
          alt={site.portrait.alt}
          width="720"
          height="900"
          class="portrait-rim aspect-[4/5] max-h-[min(44rem,52svh)] w-full object-cover object-[center_12%] md:max-h-[44rem]"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  /* Full-bleed bottom fade — matches baked-in portrait gradient height */
  .hero-portrait::after {
    content: '';
    pointer-events: none;
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 20;
    width: 100vw;
    height: 22%;
    transform: translateX(-50%);
    background: linear-gradient(
      to top,
      var(--background) 0%,
      color-mix(in oklch, var(--background) 88%, transparent) 22%,
      color-mix(in oklch, var(--background) 45%, transparent) 58%,
      transparent 100%
    );
  }
</style>
