---
import { site } from '../../content/site';

const isCurrentRole = (period: string) => period.toLowerCase() === 'present';
---

<section
  id="experience"
  class="border-border scroll-mt-28 border-b py-16 md:scroll-mt-16 md:py-20"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-6xl space-y-10 px-5 md:px-8">
    <div class="max-w-2xl space-y-3">
      <h2
        id="experience-heading"
        class="font-display m-0 text-[clamp(1.75rem,3.2vw,2.75rem)] font-semibold tracking-[-0.02em]"
      >
        Experience
      </h2>
      <p class="text-muted-foreground m-0 max-w-[55ch] text-[15px] leading-[1.6]">
        {site.experienceIntro}
      </p>
    </div>
    <ol class="experience-timeline m-0 max-w-2xl list-none p-0">
      {
        site.experience.map((item) => {
          const current = isCurrentRole(item.period);
          const orgHref = 'orgHref' in item ? item.orgHref : undefined;

          return (
            <li aria-current={current ? 'true' : undefined}>
              <article class="experience-timeline__item">
                <span
                  class:list={[
                    'experience-timeline__dot',
                    current && 'experience-timeline__dot--live',
                  ]}
                  aria-hidden="true"
                />
                <p
                  class:list={[
                    'font-label m-0',
                    current ? 'text-primary' : 'text-muted-foreground',
                  ]}
                >
                  {item.period}
                </p>
                <h3 class="font-display m-0 mt-2 text-[18px] leading-[1.1] font-semibold tracking-[-0.01em]">
                  {item.role}
                </h3>
                {
                  orgHref ? (
                    <a
                      href={orgHref}
                      class="text-muted-foreground hover:text-foreground focus-visible:ring-ring mt-1 inline-flex items-center text-[15px] leading-[1.6] underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:ring-2 focus-visible:outline-none"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {item.org}
                    </a>
                  ) : (
                    <p class="text-muted-foreground m-0 mt-1 text-[15px] leading-[1.6]">
                      {item.org}
                    </p>
                  )
                }
                <p class="text-muted-foreground m-0 mt-2 max-w-[55ch] text-[15px] leading-[1.6]">
                  {item.summary}
                </p>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .experience-timeline {
    padding-left: 1.75rem;
  }

  .experience-timeline__item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .experience-timeline__item:last-child {
    padding-bottom: 0;
  }

  .experience-timeline__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(-1.75rem + 0.3125rem);
    top: calc(0.375rem + 0.3125rem);
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .experience-timeline__dot {
    position: absolute;
    left: -1.75rem;
    top: 0.375rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--border);
  }

  .experience-timeline__dot--live {
    background: var(--primary);
  }
</style>
