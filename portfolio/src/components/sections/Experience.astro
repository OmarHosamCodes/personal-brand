---
import { site } from '../../content/site';

const isCurrentRole = (period: string) => period.toLowerCase() === 'present';
---

<section
  id="experience"
  class="border-border scroll-mt-28 border-b py-20 md:scroll-mt-16 md:py-24"
  aria-labelledby="experience-heading"
>
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 md:px-8 lg:grid-cols-[minmax(20rem,0.85fr)_minmax(0,1.15fr)] lg:gap-20"
  >
    <header class="max-w-md lg:sticky lg:top-24 lg:self-start">
      <h2
        id="experience-heading"
        class="font-display m-0 text-[clamp(2.75rem,5vw,4.5rem)] leading-[0.9] font-semibold tracking-[-0.04em]"
      >
        Experience
      </h2>
      <p
        class="text-muted-foreground m-0 mt-5 max-w-[34ch] text-[15px] leading-[1.6] md:mt-6"
      >
        {site.experienceIntro}
      </p>
      <div class="mt-8 flex flex-col gap-4">
        <div class="flex items-center gap-3" aria-hidden="true">
          <span class="bg-primary size-2.5 rounded-full"></span>
          <span class="bg-border h-px w-16"></span>
          <span class="font-label text-muted-foreground">Now broadcasting</span>
        </div>
        <p class="m-0 flex flex-col gap-1.5">
          <span class="font-label text-muted-foreground">
            {site.currentlyLearning.label}
          </span>
          <span class="text-foreground text-[15px] leading-[1.55]">
            {site.currentlyLearning.topic}
          </span>
        </p>
      </div>
    </header>

    <ol class="experience-ledger border-border m-0 list-none border-t p-0">
      {
        site.experience.map((item, index) => {
          const current = isCurrentRole(item.period);
          const orgHref = 'orgHref' in item ? item.orgHref : undefined;

          return (
            <li
              class:list={[
                'experience-ledger__row border-border relative border-b',
                current && 'experience-ledger__row--current',
              ]}
              aria-current={current ? 'true' : undefined}
            >
              <article class="grid gap-5 py-7 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8 md:py-9">
                <div class="flex items-start justify-between gap-4 sm:block">
                  <p
                    class:list={[
                      'font-label m-0 leading-[1.35]',
                      current ? 'text-primary' : 'text-muted-foreground',
                    ]}
                  >
                    {item.period}
                  </p>
                  <span class="font-label text-muted-foreground/60 sm:mt-4 sm:block">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <h3
                      class="font-display m-0 text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.05] font-semibold tracking-[-0.03em]"
                    >
                      {item.role}
                    </h3>
                    {
                      current && (
                        <span class="font-label border-primary/40 text-primary inline-flex min-h-7 items-center rounded-full border px-2.5">
                          Current
                        </span>
                      )
                    }
                  </div>
                  <div class="mt-3">
                    {
                      orgHref ? (
                        <a
                          href={orgHref}
                          class="text-foreground hover:text-primary focus-visible:ring-ring inline-flex items-center text-[15px] leading-[1.55] font-medium underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:ring-2 focus-visible:outline-none"
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {item.org}
                        </a>
                      ) : (
                        <p class="text-foreground m-0 text-[15px] leading-[1.55] font-medium">
                          {item.org}
                        </p>
                      )
                    }
                  </div>
                  <p class="text-muted-foreground m-0 mt-4 max-w-[56ch] text-[15px] leading-[1.65]">
                    {item.summary}
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .experience-ledger__row--current::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: min(8rem, 30%);
    height: 2px;
    background: var(--primary);
  }
</style>
